---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title="Blog · Miel AI" description="Notes techniques autour de l’IA embarquée, du firmware et des systèmes contraints." />
	</head>
	<body>
		<Header />
		<main>
			<section class="py-16 sm:py-20">
				<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
					<div class="flex max-w-4xl flex-col gap-5">
						<p class="text-sm font-semibold uppercase text-primary-950/55">Blog</p>
						<h1 class="text-4xl font-semibold tracking-tight text-primary-950 sm:text-5xl lg:text-6xl">
							Notes techniques
						</h1>
						<p class="max-w-2xl text-base leading-7 text-primary-950/70 sm:text-lg">
							Articles et retours d’expérience autour de l’IA embarquée, du firmware et des systèmes contraints.
						</p>
					</div>
				</div>
			</section>
			<section class="pb-16 sm:pb-20">
				<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
					{
						posts.length > 0 ? (
							<ul role="list" class="grid gap-8 lg:grid-cols-3">
								{posts.map((post) => (
									<li>
										<a
											href={`/blog/${post.id}/`}
											class="bg-primary-500/10 flex min-h-64 flex-col justify-between gap-10 rounded-3xl px-6 py-8 text-primary-950 no-underline transition hover:bg-primary-500/15"
										>
											<div class="flex flex-col gap-4">
												<h2 class="text-xl font-semibold tracking-tight">{post.data.title}</h2>
												<p class="text-base leading-7 text-primary-950/70">{post.data.description}</p>
											</div>
											<p class="text-sm font-medium text-primary-950/55">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</a>
									</li>
								))}
							</ul>
						) : (
							<div class="bg-primary-500/10 rounded-3xl px-6 py-10 text-primary-950 sm:px-8">
								<p class="max-w-2xl text-base leading-7 text-primary-950/70">
									Les premiers articles arrivent bientôt. Les sujets sont déjà posés sur la page d’accueil.
								</p>
							</div>
						)
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
