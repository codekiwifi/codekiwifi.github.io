---
const today = new Date();

const bottomLinks = [
	{
		header: 'Site',
		links: [
			{ name: 'Accueil', href: '/', isExternal: false },
			{ name: 'Projets', href: '/projets', isExternal: false },
			{ name: 'Blog', href: '/blog', isExternal: false },
			{ name: 'Contact', href: '/contact', isExternal: false },
		],
	},
	{
		header: 'Travail',
		links: [
			{ name: 'Projet Miel', href: '/projets#miel', isExternal: false },
			{ name: 'GitHub', href: 'https://github.com/codekiwifi', isExternal: true },
		],
	},
];
---

<footer class="bg-primary-500/10 mt-16 py-16 lg:mt-20 lg:py-20" aria-labelledby="footer-heading">
	<h2 id="footer-heading" class="sr-only">Pied de page</h2>
	<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
		<div class="flex flex-col justify-between gap-12 sm:gap-16 lg:flex-row">
			<div class="flex max-w-sm flex-col items-start gap-6 sm:gap-8">
				<a href="/" class="text-base font-medium text-primary-950">CodeKiwifi - Miel AI</a>
				<p class="text-sm text-primary-950/70">© {today.getFullYear()} Laurent Huang</p>
			</div>

			<div class="grid max-w-xl flex-1 grid-cols-1 gap-8 sm:grid-cols-2">
				{
					bottomLinks.map((group) => (
						<div class="flex flex-col gap-4">
							<p class="text-base font-medium text-primary-950">{group.header}</p>
							<ul role="list" class="flex flex-col gap-3">
								{group.links.map((link) => (
									<li>
										<a
											href={link.href}
											class="inline-flex items-center gap-1 rounded-md text-base text-primary-950/70 hover:text-primary-950 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-950"
											target={link.isExternal ? '_blank' : undefined}
											rel={link.isExternal ? 'noopener' : undefined}
										>
											{link.name}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</div>
</footer>
