---
const links = [
	{ name: 'Projet', href: '/#projet-miel' },
	{ name: 'Blog', href: '/blog' },
	{ name: 'Contact', href: '/contact' },
];
---

<header class="bg-primary-50">
	<div
		class="mx-auto flex max-w-2xl items-center justify-end px-4 py-4 sm:px-6 sm:py-6 lg:max-w-7xl lg:px-8"
	>
		<nav class="flex items-center gap-6 text-sm font-medium text-primary-950 sm:gap-8 sm:text-base">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="rounded-md hover:text-primary-950/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-950"
					>
						{link.name}
					</a>
				))
			}
		</nav>
	</div>
</header>
